---
interface Props {
  navItems: { label: string; href: string }[];
  ctaLabel: string;
  ctaHref: string;
}

const { navItems, ctaLabel, ctaHref } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="logo-link" href="/">
      <img class="logo" src="/logo.svg" alt="Eastroad Technologies" height="60" />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          navItems.map((link) => (
            <li>
              <a class="nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a class="cta" href={ctaHref}>{ctaLabel}</a>
    </nav>

    <button
      class="menu-toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <ul class="mobile-menu__list">
      {
        navItems.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <a class="mobile-menu__cta" href={ctaHref}>{ctaLabel}</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }

  .site-header__inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo-link {
    display: flex;
    flex-shrink: 0;
  }

  .logo {
    display: block;
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav__list {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--blue);
  }

  .cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--blue);
    border-radius: var(--radius);
    color: var(--blue);
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    padding: 9px 18px;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta:hover {
    background: var(--blue);
    color: #fff;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 760px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-menu {
      display: block;
      border-top: 1px solid var(--rule);
      padding: 20px 24px 24px;
    }

    .mobile-menu[hidden] {
      display: none;
    }

    .mobile-menu__list {
      list-style: none;
      margin: 0 0 20px;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .mobile-menu__list a {
      font-size: 15px;
      color: var(--ink);
      text-decoration: none;
    }

    .mobile-menu__cta {
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--blue);
      color: #fff;
      border-radius: var(--radius);
      padding: 13px 28px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
    }

    .mobile-menu__cta:hover {
      background: var(--blue-dark);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.hidden;
      menu.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
