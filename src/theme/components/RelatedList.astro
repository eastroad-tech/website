---
interface Props {
  items: { title: string; meta: string; href: string }[];
  heading?: string;
}

const { items, heading = 'Related reading' } = Astro.props;
---

<section class="related-list">
  <h2>{heading}</h2>
  <ul>
    {
      items.map((item) => (
        <li>
          <a class="row" href={item.href}>
            <span class="row__title">{item.title}</span>
            <span class="row__meta">{item.meta}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .related-list {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding: 64px 24px;
  }

  h2 {
    font-size: var(--text-h3);
    margin-bottom: 24px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .row:hover .row__title {
    color: var(--blue);
  }

  .row__title {
    font-size: 16px;
    font-weight: 500;
  }

  .row__meta {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--ls-tag);
    color: var(--gray);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .row {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
