---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import CapabilityLayout from '../../theme/layouts/CapabilityLayout.astro';

// Normalized so `${base}/path` is correct whether BASE_URL is "/", "/website", etc.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Single source for the five capability pages — feeds both the nav
// dropdown and the footer's Capabilities column.
const capabilitiesList = [
  { label: 'Technology Advisory & Strategy', href: `${base}/capabilities/technology-advisory-strategy` },
  { label: 'Architecture & System Design', href: `${base}/capabilities/architecture-system-design` },
  { label: 'Software Engineering', href: `${base}/capabilities/software-engineering` },
  { label: 'AI Systems Engineering', href: `${base}/capabilities/ai-systems-engineering` },
  { label: 'Analytics & Calibration Operations', href: `${base}/capabilities/analytics-calibration-operations` },
];
---
<BaseLayout
  title="Analytics & Calibration Operations — Eastroad"
  description="Measurement, pricing, data quality, and training-data operations that support better decisions and more reliable systems."
  navItems={[
    { label: 'Capabilities', href: `${base}/capabilities`, children: capabilitiesList },
    { label: 'How we work', href: `${base}/#how-we-work` },
    { label: 'Research', href: `${base}/research` },
    { label: 'About', href: `${base}/about` },
  ]}
  ctaLabel="Talk to us"
  ctaHref="https://calendar.app.google/ESqGVNzc2HQ6kDP99"
  positioningLine="Strategy. Architecture. Engineering."
  footerCapabilities={capabilitiesList}
  firmLinks={[
    { label: 'How We Work', href: `${base}/#how-we-work` },
    { label: 'Research', href: `${base}/research` },
    { label: 'About', href: `${base}/about` },
    { label: 'Talk to us', href: 'https://calendar.app.google/ESqGVNzc2HQ6kDP99' },
  ]}
  details={[
    'India (HQ)',
    'Client engagements across North America, Europe, the Middle East, and South Asia',
  ]}
  linkedinUrl="https://www.linkedin.com/company/eastroad-technologies"
  legalLine="© 2026 Eastroad Technologies Pvt. Ltd. · Privacy · Terms"
>
  <CapabilityLayout
    breadcrumb="Capabilities / Analytics & Calibration Operations"
    title="Analytics & Calibration Operations"
    dek="Measurement, pricing, data quality, and training-data operations that support better decisions and more reliable systems."
    framingParagraphs={[
      "Decisions are only as good as the evidence behind them. Measurement, data quality, pricing logic, and training-data operations shape whether a strategy is credible, a product is commercially sound, or an AI system performs as expected.",
      "This work provides the feedback infrastructure the rest of the practice depends on: commercial analysis for strategic decisions, customer and pricing data for product work, training-data pipelines for AI systems."
    ]}
    scope={[
      "Market and competitive intelligence",
      "Pricing strategy and commercial model design",
      "Customer behaviour analysis",
      "Training-data pipeline design and implementation",
      "Data labelling and annotation operations"
    ]}
    engagementFit={{
      text: "This capability most often supports a Build and Operate engagement, providing the measurement, pricing, and data-quality discipline underneath delivery. It can also continue as Embedded Advisory when those decisions and operating processes need ongoing attention.",
      linkLabel: "See how we engage",
      linkHref: `${base}/#how-we-engage`
    }}
    relatedCapability={{
      label: "Technology Advisory & Strategy — where the evidence built here informs investment, sequencing, and build-vs-buy decisions.",
      href: `${base}/capabilities/technology-advisory-strategy`
    }}
  />
</BaseLayout>
