---
import BaseLayout from '../theme/layouts/BaseLayout.astro';
import Kicker from '../theme/components/Kicker.astro';
import ClosingCTA from '../theme/components/ClosingCTA.astro';

// Normalized so `${base}/path` is correct whether BASE_URL is "/", "/website", etc.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Single source for the five capability pages — feeds both the nav
// dropdown and the footer's Capabilities column.
const capabilitiesList = [
  { label: 'Technology Advisory & Strategy', href: `${base}/capabilities/technology-advisory-strategy` },
  { label: 'Architecture & System Design', href: `${base}/capabilities/architecture-system-design` },
  { label: 'Software Engineering', href: `${base}/capabilities/software-engineering` },
  { label: 'AI Systems Engineering', href: `${base}/capabilities/ai-systems-engineering` },
  { label: 'Analytics & Calibration Operations', href: `${base}/capabilities/analytics-calibration-operations` },
];
---
<BaseLayout
  title="About — Eastroad Technologies"
  description="Eastroad is founder-led by Sidharth Sharma."
  navItems={[
    { label: 'Capabilities', href: `${base}/capabilities`, children: capabilitiesList },
    { label: 'How we work', href: `${base}/#how-we-work` },
    { label: 'Research', href: `${base}/research` },
    { label: 'About', href: `${base}/about` },
  ]}
  ctaLabel="Talk to us"
  ctaHref="https://calendar.app.google/ESqGVNzc2HQ6kDP99"
  positioningLine="Strategy. Architecture. Engineering."
  footerCapabilities={capabilitiesList}
  firmLinks={[
    { label: 'How We Work', href: `${base}/#how-we-work` },
    { label: 'Research', href: `${base}/research` },
    { label: 'About', href: `${base}/about` },
    { label: 'Talk to us', href: 'https://calendar.app.google/ESqGVNzc2HQ6kDP99' },
  ]}
  details={[
    'India (HQ)',
    'Client engagements across North America, Europe, the Middle East, and South Asia',
  ]}
  linkedinUrl="https://www.linkedin.com/company/eastroad-technologies"
  legalLine="© 2026 Eastroad Technologies Pvt. Ltd. · Privacy · Terms"
>
  <div class="container-narrow about">
    <Kicker label="About" />
    <h1>Led by the person doing the work.</h1>

    <div class="about__body">
      <p>
        Eastroad is founder-led. Sidharth Sharma founded the firm after roles in software engineering,
        banking technology, and product management at Ansys, Bank of America Securities, Vertica,
        Leonardo247, and Amazon.
      </p>

      <p>
        He also founded and ran Bhumilinks Commerce, a B2B procurement and embedded-finance platform for
        manufacturing MSMEs, through to profitability.
      </p>

      <p>
        He holds degrees from IIT Patna, Rensselaer Polytechnic Institute, and UCLA Anderson.{' '}
        <a class="inline-link" href="https://www.linkedin.com/in/sidharthgsharma/" target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>.
      </p>

      <h2>Why Eastroad</h2>
      <ul class="why-eastroad">
        <li><strong>Accountable senior ownership.</strong> No delivery pyramid — the person who takes the engagement remains on it.</li>
        <li><strong>Strategy connected to implementation.</strong> Recommendations come from someone who has also lived with their consequences.</li>
        <li><strong>Analytical reasoning.</strong> Trade-offs are made explicit and assumptions are stated.</li>
        <li><strong>Focused scope.</strong> Eastroad works at the intersection of AI, software systems, data, and decision-making — not general-purpose outsourcing.</li>
      </ul>
    </div>
  </div>

  <ClosingCTA
    heading="Facing a consequential technology decision?"
    body="Begin with a structured conversation about the problem, the decision at hand, and the credible path to execution."
  />
</BaseLayout>

<style>
  .about {
    /* .container-narrow already supplies the horizontal gutter (padding-inline)
       and max-width — only vertical spacing is added here. */
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .about h1 {
    margin-top: 16px;
    font-size: var(--text-h1-article);
    line-height: var(--lh-h1-article);
  }

  .about__body {
    margin-top: 40px;
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  .about__body p {
    color: var(--gray);
  }

  .about__body p + p {
    margin-top: 20px;
  }

  .about__body h2 {
    margin-top: 48px;
    margin-bottom: 16px;
    font-size: var(--text-h2-content);
    line-height: var(--lh-h2-content);
    color: var(--ink);
  }

  .inline-link {
    color: var(--blue);
    border-bottom: 1px solid var(--blue);
    padding-bottom: 1px;
    text-decoration: none;
  }

  .inline-link:hover {
    color: var(--blue-dark);
    border-color: var(--blue-dark);
  }

  .why-eastroad {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .why-eastroad li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--gray);
  }

  .why-eastroad li::marker {
    color: var(--blue);
  }

  .why-eastroad strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
